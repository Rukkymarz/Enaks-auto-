        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('On any SOC workflow error').item.json.workflow.name, node: ($('On any SOC workflow error').item.json.execution.lastNodeExecuted || ''), message: String(($('On any SOC workflow error').item.json.execution.error || {}).message || 'unknown').slice(0, 900), execution_url: $('On any SOC workflow error').item.json.execution.url || null }) }}"
      },
      "id": "b284091c-408c-4a46-ac6d-ce2a5f7a9a51",
      "name": "Log error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Get config').first().json.from_email }}",
        "toEmail": "={{ $('Get config').first().json.approval_email }}",
        "subject": "=n8n error: {{ $('On any SOC workflow error').item.json.workflow.name }}",
        "emailFormat": "html",
        "html": "=<p><b>Workflow:</b> {{ $('On any SOC workflow error').item.json.workflow.name }}<br><b>Node:</b> {{ $('On any SOC workflow error').item.json.execution.lastNodeExecuted }}</p><p><b>Error:</b> {{ ($('On any SOC workflow error').item.json.execution.error || {}).message }}</p><p>{{ $('On any SOC workflow error').item.json.execution.url ? '<a href=\"' + $('On any SOC workflow error').item.json.execution.url + '\">Open the execution</a>' : '' }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "3879e4ca-e3bb-44d1-ad4f-ebefa9b16b12",
      "name": "Email the error",
