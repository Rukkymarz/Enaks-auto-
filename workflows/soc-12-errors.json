{
  "id": "socErrors0000001",
  "name": "SOC-12 Error Monitoring and Recovery",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "998ce688-b32f-4406-9248-28e17ce674dc",
      "name": "On any SOC workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/rpc/soc_config_obj",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "id": "bb6a9105-2b07-450c-bf64-ea1e4d371f48",
      "name": "Get config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/soc_errors",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('On any SOC workflow error').item.json.workflow.name, node: ($('On any SOC workflow error').item.json.execution.lastNodeExecuted || ''), message: String(($('On any SOC workflow error').item.json.execution.error || {}).message || 'unknown').slice(0, 900), execution_url: $('On any SOC workflow error').item.json.execution.url || null }) }}"
      },
      "id": "691deede-a20d-45db-b057-7c07bb6283df",
      "name": "Log error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Get config').first().json.from_email }}",
        "toEmail": "={{ $('Get config').first().json.approval_email }}",
        "subject": "=n8n error: {{ $('On any SOC workflow error').item.json.workflow.name }}",
        "emailFormat": "html",
        "html": "=<p><b>Workflow:</b> {{ $('On any SOC workflow error').item.json.workflow.name }}<br><b>Node:</b> {{ $('On any SOC workflow error').item.json.execution.lastNodeExecuted }}</p><p><b>Error:</b> {{ ($('On any SOC workflow error').item.json.execution.error || {}).message }}</p><p>{{ $('On any SOC workflow error').item.json.execution.url ? '<a href=\"' + $('On any SOC workflow error').item.json.execution.url + '\">Open the execution</a>' : '' }}</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "78fa10bd-41e8-41f1-ac01-37ba23883588",
      "name": "Email the error",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "credentials": {
        "smtp": {
          "name": "Social email (SMTP)"
        }
      }
    }
  ],
  "connections": {
