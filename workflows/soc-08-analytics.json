      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        80
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/soc_content?status=eq.published&published_at=gte.{{ $now.minus({days: 30}).toISO() }}&select=id,platforms,postiz_posts",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "id": "dd183f9d-20f9-4535-bcf7-98c3c737a8c8",
      "name": "Recent published posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        40
      ],
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const i of $input.all()) for (const p of (i.json.postiz_posts || []))\n  out.push({ json: { content_id: i.json.id, postId: p.postId, integration: p.integration } });\nreturn out;"
      },
      "id": "be2eea43-358e-442e-8eea-c07c99428909",
      "name": "One row per Postiz post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Get config').first().json.postiz_base_url }}/analytics/post/{{ $json.postId }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "c0a1df2c-53b9-4200-895b-db2024d77759",
      "name": "Get post analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        40
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Postiz API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('One row per Postiz post').all();\nconst cfg = $('Get config').first().json;\nconst byInteg = Object.fromEntries(Object.entries(cfg.postiz_integrations || {}).map(([k, v]) => [v, k]));\nconst rows = [];\n$input.all().forEach((i, idx) => {\n  const s = src[idx] && src[idx].json; if (!s) return;\n  const series = Array.isArray(i.json) ? i.json : (Array.isArray(i.json.data) ? i.json.data : (i.json.label ? [i.json] : []));\n  for (const m of series) {\n    const pts = Array.isArray(m.data) ? m.data : [];\n    if (!m.label || !pts.length) continue;\n    const last = pts[pts.length - 1];\n    const v = Number(last.total);\n    if (!Number.isFinite(v)) continue;\n    rows.push({ content_id: s.content_id, platform: byInteg[s.integration] || s.integration, postiz_post_id: s.postId, metric: m.label, value: v, raw: m });\n  }\n});\nreturn rows.length ? [{ json: { rows } }] : [];"
      },
      "id": "09fbae12-d65b-47ab-88d2-623bb6484cba",
      "name": "Flatten metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ]
    },
