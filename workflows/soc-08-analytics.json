            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "2a55d870-95d1-451f-bbc7-463b815a930e",
              "leftValue": "={{ Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value])).postiz_base_url }}",
              "operator": {
                "type": "string",
