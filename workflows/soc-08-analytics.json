        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}"
      },
      "id": "4cf2b604-d3b5-4b7e-86d7-9120e7cf238c",
