      "id": "8750f3fa-855f-4f8c-9ae5-1506547c9ade",
      "name": "Postiz configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        80
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/soc_content?status=eq.published&published_at=gte.{{ $now.minus({days: 30}).toISO() }}&select=id,platforms,postiz_posts",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi"
      },
      "id": "adff66eb-1bea-4f9b-9880-cf6408148786",
      "name": "Recent published posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        40
      ],
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const i of $input.all()) for (const p of (i.json.postiz_posts || []))\n  out.push({ json: { content_id: i.json.id, postId: p.postId, integration: p.integration } });\nreturn out;"
      },
      "id": "27173f60-9010-4d2e-ba94-c3fb5e51dd17",
      "name": "One row per Postiz post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value])).postiz_base_url }}/analytics/post/{{ $json.postId }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "4df34522-f238-4b98-b698-c2f1383d2c25",
      "name": "Get post analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        40
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Postiz API key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('One row per Postiz post').all();\nconst cfg = Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value]));\nconst byInteg = Object.fromEntries(Object.entries(cfg.postiz_integrations || {}).map(([k, v]) => [v, k]));\nconst rows = [];\n$input.all().forEach((i, idx) => {\n  const s = src[idx] && src[idx].json; if (!s) return;\n  const series = Array.isArray(i.json) ? i.json : (Array.isArray(i.json.data) ? i.json.data : (i.json.label ? [i.json] : []));\n  for (const m of series) {\n    const pts = Array.isArray(m.data) ? m.data : [];\n    if (!m.label || !pts.length) continue;\n    const last = pts[pts.length - 1];\n    const v = Number(last.total);\n    if (!Number.isFinite(v)) continue;\n    rows.push({ content_id: s.content_id, platform: byInteg[s.integration] || s.integration, postiz_post_id: s.postId, metric: m.label, value: v, raw: m });\n  }\n});\nreturn rows.length ? [{ json: { rows } }] : [];"
      },
      "id": "3b7c5b0c-ac43-4e5f-bb6b-81f999945323",
      "name": "Flatten metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/soc_metrics",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}"
      },
      "id": "48facb47-6244-46cd-9ebe-1988405abce4",
      "name": "Store metrics",
