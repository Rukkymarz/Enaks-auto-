    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const i of $input.all()) for (const post of (i.json.data || [])) for (const c of ((post.comments || {}).data || []))\n  out.push({ json: { platform: 'facebook', external_id: c.id, author: (c.from && c.from.name) || 'unknown', message: c.message || '', received_at: c.created_time } });\nreturn out;"
      },
