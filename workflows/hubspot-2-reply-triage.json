    {
      "id": "581d6e6d-db30-46b2-a88e-31834fe082d7",
      "name": "HubSpot: unqualified",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [
        1360,
        -200
      ],
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $('Sender').item.json.from_email }}",
