        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "p9EdDji7jFNnxWgo",
          "cachedResultName": "ECC Outreach"
        },
        "matchType": "anyCondition",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Sender').item.json.from_email }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "unsubscribed"
          },
          "matchingColumns": [],
