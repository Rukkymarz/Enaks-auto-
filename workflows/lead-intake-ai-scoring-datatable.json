            },
            {
              "name": "tier",
              "description": "Exactly one of: hot, warm, cold",
              "required": true
            },
            {
              "name": "reason",
              "description": "One sentence explaining the score",
              "required": true
            },
            {
              "name": "next_step",
              "description": "One concrete next action for the owner, e.g. call within 1 hour, send quote, request photos",
              "required": true
            }
          ]
        },
