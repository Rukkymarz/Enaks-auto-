              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dd620944-6f53-41c8-b4f6-15cf61f2ddc1",
      "name": "Postiz configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/rpc/soc_claim_due",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "id": "79e77c3c-7fae-4ceb-a8a7-e97b77386eaf",
      "name": "Claim one due post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        40
      ],
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const i of $input.all()) {\n  const urls = i.json.media_urls || [];\n  if (!urls.length) out.push({ json: { post: i.json, url: null } });\n  for (const url of urls) out.push({ json: { post: i.json, url } });\n}\nreturn out;"
      },
      "id": "fab0dda5-d6fa-4779-ba65-10e7ee3dfd37",
      "name": "Media list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f994d0c6-6eaa-4e3f-86af-3e959926b7bc",
              "leftValue": "={{ $json.url }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "76bd9714-4cea-4513-ad40-366dbf0ca44c",
      "name": "Has media?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Get config').first().json.postiz_base_url }}/upload-from-url",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url }) }}"
      },
      "id": "45ba1661-b485-4304-9e65-64eb191f72f4",
      "name": "Upload media to Postiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -40
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Postiz API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "09a4d71d-a63f-4f5a-b5ea-f0a44d3615b1",
      "name": "Collect media",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1540,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Get config').first().json;\nconst post = $('Claim one due post').first().json;\nconst c = post.content || {};\nconst cap = c.captions || {};\nconst images = $('Upload media to Postiz').isExecuted ? $('Upload media to Postiz').all().map(i => ({ id: i.json.id, path: i.json.path })) : [];\nconst tags = (c.hashtags || []).map(h => h.startsWith('#') ? h : '#' + h).join(' ');\nconst settingsFor = (p) => ({\n  x: { __type: 'x', who_can_reply_post: 'everyone' },\n  youtube: { __type: 'youtube', title: (c.youtube && c.youtube.title) || c.title || post.topic, type: 'public' },\n  pinterest: { __type: 'pinterest', board: cfg.pinterest_board || '' },\n  tiktok: { __type: 'tiktok', privacy_level: 'PUBLIC_TO_EVERYONE', duet: false, stitch: false, comment: true, autoAddMusic: 'no', brand_content_toggle: false, brand_organic_toggle: false, content_posting_method: 'DIRECT_POST' },\n}[p] || { __type: p });\nconst posts = [], skipped = [];\nfor (const p of post.platforms || []) {\n  const integ = (cfg.postiz_integrations || {})[p];\n  const text = cap[p];\n  if (!integ || !text) { skipped.push(p); continue; }\n  posts.push({ integration: { id: integ }, value: [{ content: p === 'x' ? text : (text + (tags ? '\\n\\n' + tags : '')), image: images }], settings: settingsFor(p) });\n}\nreturn [{ json: { id: post.id, skipped, body: { type: 'now', date: new Date().toISOString(), shortLink: false, tags: [], posts } } }];"
      },
      "id": "b666de12-6150-4562-b0b5-509e1172408d",
      "name": "Build Postiz request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
