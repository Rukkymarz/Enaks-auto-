        220,
        80
      ],
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b27019c8-9dd2-414d-aacc-422c9def61c8",
              "leftValue": "={{ $('Get config').first().json.postiz_base_url }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
