      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cnlvbusjqwepotvlqcgx.supabase.co/rest/v1/rpc/soc_claim_due",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      },
      "id": "807603d4-f455-45c4-8e0f-f3a9c712f95e",
      "name": "Claim one due post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        40
      ],
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const i of $input.all()) {\n  const urls = i.json.media_urls || [];\n  if (!urls.length) out.push({ json: { post: i.json, url: null } });\n  for (const url of urls) out.push({ json: { post: i.json, url } });\n}\nreturn out;"
      },
      "id": "3933b1e2-ecef-4d50-95e9-ce6cdcddfa2b",
      "name": "Media list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9225b004-0931-4c69-8871-ebb6561aff5c",
              "leftValue": "={{ $json.url }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8e6a2af0-3981-4435-a965-97335e5651b4",
      "name": "Has media?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value])).postiz_base_url }}/upload-from-url",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url }) }}"
      },
      "id": "6849fb52-05cc-40ff-9322-9f61bf07d38a",
      "name": "Upload media to Postiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -40
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Postiz API key"
        }
      }
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "a3f6e035-0a70-482f-9657-37c1b341fed3",
      "name": "Collect media",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1540,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value]));\nconst post = $('Claim one due post').first().json;\nconst c = post.content || {};\nconst cap = c.captions || {};\nconst images = $('Upload media to Postiz').isExecuted ? $('Upload media to Postiz').all().map(i => ({ id: i.json.id, path: i.json.path })) : [];\nconst tags = (c.hashtags || []).map(h => h.startsWith('#') ? h : '#' + h).join(' ');\nconst settingsFor = (p) => ({\n  x: { __type: 'x', who_can_reply_post: 'everyone' },\n  youtube: { __type: 'youtube', title: (c.youtube && c.youtube.title) || c.title || post.topic, type: 'public' },\n  pinterest: { __type: 'pinterest', board: cfg.pinterest_board || '' },\n  tiktok: { __type: 'tiktok', privacy_level: 'PUBLIC_TO_EVERYONE', duet: false, stitch: false, comment: true, autoAddMusic: 'no', brand_content_toggle: false, brand_organic_toggle: false, content_posting_method: 'DIRECT_POST' },\n}[p] || { __type: p });\nconst posts = [], skipped = [];\nfor (const p of post.platforms || []) {\n  const integ = (cfg.postiz_integrations || {})[p];\n  const text = cap[p];\n  if (!integ || !text) { skipped.push(p); continue; }\n  posts.push({ integration: { id: integ }, value: [{ content: p === 'x' ? text : (text + (tags ? '\\n\\n' + tags : '')), image: images }], settings: settingsFor(p) });\n}\nreturn [{ json: { id: post.id, skipped, body: { type: 'now', date: new Date().toISOString(), shortLink: false, tags: [], posts } } }];"
      },
      "id": "10b65769-2b89-484f-b784-4d0b748a47ad",
      "name": "Build Postiz request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
