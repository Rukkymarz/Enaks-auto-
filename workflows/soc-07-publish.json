      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5fff92c4-911a-4f8b-b4a1-d4ebc28f7ed3",
              "leftValue": "={{ Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value])).postiz_base_url }}",
