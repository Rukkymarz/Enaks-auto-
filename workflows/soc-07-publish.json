      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        80
      ],
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "name": "Social DB (Supabase)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f99cf7ad-12dc-49b3-97c0-426ca8eb7382",
              "leftValue": "={{ Object.fromEntries($('Get config').all().map(i => [i.json.key, i.json.value])).postiz_base_url }}",
              "operator": {
