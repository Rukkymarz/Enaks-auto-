              "type": "array",
              "value": "={{ [{\"segment\": \"Property managers\", \"goal\": \"client\", \"titles\": [\"property manager\", \"community manager\", \"regional property manager\", \"portfolio manager\"], \"org_keywords\": [], \"pitch\": \"recurring common-area cleaning, unit turnovers and move-out cleans across their properties\", \"location\": \"United States\", \"per_page\": 4}, {\"segment\": \"Facility / office managers\", \"goal\": \"client\", \"titles\": [\"facilities manager\", \"office manager\", \"facility director\", \"operations manager\"], \"org_keywords\": [], \"pitch\": \"recurring office and janitorial cleaning on their schedule, including after-hours\", \"location\": \"United States\", \"per_page\": 4}, {\"segment\": \"Realtors\", \"goal\": \"client\", \"titles\": [\"realtor\", \"real estate agent\", \"real estate broker\"], \"org_keywords\": [], \"pitch\": \"pre-listing deep cleans and move-in/move-out cleans that help listings show and close faster\", \"location\": \"United States\", \"per_page\": 3}, {\"segment\": \"Contractors / builders\", \"goal\": \"client\", \"titles\": [\"general contractor\", \"construction project manager\", \"superintendent\", \"owner\"], \"org_keywords\": [\"construction\", \"general contractor\", \"home builder\"], \"pitch\": \"post-construction and final cleans so jobs are handed over spotless and on schedule\", \"location\": \"United States\", \"per_page\": 3}, {\"segment\": \"Short-term rental managers\", \"goal\": \"client\", \"titles\": [\"owner\", \"operations manager\", \"property manager\", \"founder\"], \"org_keywords\": [\"vacation rental\", \"short term rental\", \"airbnb management\"], \"pitch\": \"fast, reliable turnover cleans between guests with consistent quality\", \"location\": \"United States\", \"per_page\": 3}, {\"segment\": \"Partner cleaners\", \"goal\": \"partner\", \"titles\": [\"owner\", \"founder\", \"cleaning manager\"], \"org_keywords\": [\"cleaning services\", \"janitorial services\", \"maid service\", \"house cleaning\"], \"pitch\": \"steady, pre-quoted cleaning jobs in their area through our nationwide booking network, with the scope agreed before they arrive\", \"location\": \"United States\", \"per_page\": 3}] }}"
